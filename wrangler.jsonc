{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pmhub",
  "compatibility_date": "2026-08-20",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pmhub-production",
      "database_id": "29d715f5-0a9e-467c-9e6f-f53b989b00a8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "pmhub-evidence"
    }
  ]
}
